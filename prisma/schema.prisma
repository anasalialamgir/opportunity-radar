datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  profile       UserProfile?
  savedOpportunities SavedOpportunity[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserProfile {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // ApplyBlast-style Target Preferences
  targetRoles             String[] @default([])
  seniorityLevel          String   @default("Mid-level") // Entry, Mid-level, Senior, Lead
  workModel               String   @default("Remote")    // Remote, Hybrid, Onsite, Any
  preferredLocations      String[] @default([])
  openToRelocate          Boolean  @default(false)
  
  // Compensation Requirements
  currency                String   @default("USD")
  minHourlyPay            Float?   @default(0)
  minMonthlyPay           Float?   @default(0)
  
  // Skills & Experience
  skills                  String[] @default([])
  rawCvText               String?  @db.Text
  cvFileName              String?
  
  // Alert Mechanism (Integrated directly into Profile)
  emailAlertsEnabled      Boolean  @default(true)
  alertFrequency          String   @default("instant")   // instant, daily, weekly
  smsAlertsEnabled        Boolean  @default(false)
  phoneNumber             String?
  carrierGatewayDomain    String?  // e.g., txt.att.net, vtext.com, or custom gateway
  
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Opportunity {
  id             String    @id @default(cuid())
  title          String
  company        String
  location       String
  workType       String    // Remote, Hybrid, Onsite
  compensation   String?
  minHourlyPay   Float?
  minMonthlyPay  Float?
  currency       String?   @default("USD")
  description    String    @db.Text
  url            String
  source         String
  isVerified     Boolean   @default(true)
  matchScore     Int?      @default(0)
  tags           String[]  @default([])
  postedDate     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  
  savedBy        SavedOpportunity[]
}

model SavedOpportunity {
  id             String      @id @default(cuid())
  userId         String
  opportunityId  String
  status         String      @default("SAVED") // SAVED, APPLIED, INTERVIEW, OFFER, REJECTED
  notes          String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
}
