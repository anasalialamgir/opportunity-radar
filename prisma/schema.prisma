datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// Authentication Models (NextAuth Compatible)
// -------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  profile            Profile?
  savedOpportunities SavedOpportunity[]
  applications       Application[]
  matches            OpportunityMatch[]
  notifications      Notification[]
}

// -------------------------------------------------------------
// User Profile & Capability Models
// -------------------------------------------------------------

model Profile {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  country                 String?
  timeZone                String?
  locationPreference      String?  // remote, hybrid, local, any
  hoursPerWeek            Int?     @default(40)
  targetMonthlyIncome     Float?
  minimumCompensation     Float?
  currency                String   @default("USD")
  employmentPreferences   String[] // Full-time, Part-time, Freelance, Contract, Gig, Business
  languages               String[]
  rawCvText               String?  @db.Text
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills           Skill[]
  experiences      Experience[]
  education        Education[]
  certifications   Certification[]
  userCapabilities UserCapability[]
}

model Skill {
  id        String   @id @default(cuid())
  profileId String
  name      String
  category  String?  // technical, soft, domain
  years     Float?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Experience {
  id          String   @id @default(cuid())
  profileId   String
  title       String
  company     String?
  years       Float?
  summary     String?  @db.Text

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Education {
  id          String   @id @default(cuid())
  profileId   String
  degree      String
  institution String
  year        Int?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Certification {
  id        String   @id @default(cuid())
  profileId String
  name      String
  issuer    String?
  year      Int?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model UserCapability {
  id          String   @id @default(cuid())
  profileId   String
  description String   // e.g. "I can translate Urdu/English", "I understand car maintenance"
  createdAt   DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// Opportunity Discovery & Matching Models
// -------------------------------------------------------------

model Opportunity {
  id                 String    @id @default(cuid())
  title              String
  description        String    @db.Text
  category           String    // job, freelance, contract, gig, business, grant, competition, research, open_source, creator, other
  source             String    // reddit, github, rss, web-search
  sourceUrl          String    @unique
  company            String?
  location           String?
  remote             Boolean   @default(false)
  minCompensation    Float?
  maxCompensation    Float?
  currency           String?
  compensationPeriod String?   // hourly, fixed, monthly, yearly
  requirements       String[]
  skills             String[]
  publishedAt        DateTime?
  deadline           DateTime?
  discoveredAt       DateTime  @default(now())
  verificationStatus String    @default("unverified") // unverified, source_confirmed, verified
  rawData            Json?

  matches            OpportunityMatch[]
  savedOpportunities SavedOpportunity[]
  applications       Application[]
}

model OpportunityMatch {
  id             String   @id @default(cuid())
  userId         String
  opportunityId  String
  matchScore     Int      // 0 - 100
  reasons        String[] // Bullet points explaining why it matches
  concerns       String[] // Missing skills or requirements
  createdAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
}

model SavedOpportunity {
  id            String   @id @default(cuid())
  userId        String
  opportunityId String
  savedAt       DateTime @default(now())
  dismissed     Boolean  @default(false)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
}

model Application {
  id            String   @id @default(cuid())
  userId        String
  opportunityId String
  status        String   @default("Preparing") // Discovered, Saved, Preparing, Applied, Interview, Offer, Rejected, Closed
  notes         String?  @db.Text
  appliedAt     DateTime?
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String   @db.Text
  channel   String   // email, telegram
  sentAt    DateTime @default(now())
  read      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
