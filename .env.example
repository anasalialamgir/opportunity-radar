# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/opportunity_radar?schema=public"

# NextAuth authentication secret & base URL
NEXTAUTH_SECRET="your-random-secret-key-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# AI Provider Configuration (openai | anthropic | ollama)
AI_PROVIDER="openai"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# Email Delivery Provider (optional for Phase 1)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Opportunity Radar <notifications@opportunityradar.org>"
