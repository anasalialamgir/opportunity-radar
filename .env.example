# PostgreSQL connection, required outside Docker Compose
DATABASE_URL="postgresql://radar:change_me@localhost:5432/opportunity_radar?schema=public"
# Generate with: openssl rand -base64 48
NEXTAUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
NEXTAUTH_URL="http://localhost:3000"
# Docker Compose database password (use letters, numbers, hyphens; URL-encode special characters)
POSTGRES_PASSWORD="replace-this-with-a-long-unique-password"
# Gemini-backed CV parsing, application assistance, and semantic matching
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
# Or set AI_PROVIDER=openai with OPENAI_API_KEY
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Or set AI_PROVIDER=ollama and run a JSON-capable local model
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"
# Resend SMTP: host smtp.resend.com, port 465, user resend, password is a Resend API key.
# EMAIL_FROM must be an address on your verified sending domain.
# Email verification, password reset, and scheduled job alerts
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Opportunity Radar <alerts@your-domain.com>"
CRON_SECRET="replace-with-another-long-random-secret"
SCAN_INTERVAL_MINUTES="360"
# Required for public HTTPS deployment via compose.prod.yml
DOMAIN="jobs.your-domain.com"
